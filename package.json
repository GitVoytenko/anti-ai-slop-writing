{
  "name": "anti-ai-slop-writing",
  "version": "2.4.0",
  "description": "A Claude skill that writes human-sounding English, Russian and Ukrainian, plus a zero-dependency detector for AI writing patterns",
  "type": "module",
  "license": "MIT",
  "author": "Dmitrii Voitenko",
  "homepage": "https://github.com/GitVoytenko/anti-ai-slop-writing#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GitVoytenko/anti-ai-slop-writing.git"
  },
  "bugs": {
    "url": "https://github.com/GitVoytenko/anti-ai-slop-writing/issues"
  },
  "keywords": [
    "ai-writing",
    "claude",
    "claude-code",
    "claude-skill",
    "writing",
    "linter",
    "russian",
    "ukrainian"
  ],
  "bin": {
    "aislop": "detector/cli.js"
  },
  "exports": {
    ".": "./detector/index.js",
    "./detector": "./detector/index.js",
    "./skill": "./SKILL.md"
  },
  "files": [
    "SKILL.md",
    "references/",
    "detector/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "lint:skill": "node scripts/validate-skill.js",
    "self-scan": "node scripts/self-scan.js",
    "check": "npm test && npm run lint:skill && node scripts/self-scan.js --check",
    "stats": "node scripts/stats.js"
  }
}
